; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="VoxelPrototype"
config/description="Prototype voxel terrain world for Godot 4.5"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[input]

action_interact={"deadzone":0.5,"events":[{"device":-1,"button_index":1,"button_mask":0,"doubleclick":false,"pressed":false,"type":"InputEventMouseButton"}]}
action_alt_interact={"deadzone":0.5,"events":[{"device":-1,"button_index":2,"button_mask":0,"doubleclick":false,"pressed":false,"type":"InputEventMouseButton"}]}
action_move_forward={"deadzone":0.5,"events":[{"device":-1,"keycode":87,"physical_keycode":87,"unicode":0,"pressed":false,"type":"InputEventKey"}]}
action_move_backward={"deadzone":0.5,"events":[{"device":-1,"keycode":83,"physical_keycode":83,"unicode":0,"pressed":false,"type":"InputEventKey"}]}
action_move_left={"deadzone":0.5,"events":[{"device":-1,"keycode":65,"physical_keycode":65,"unicode":0,"pressed":false,"type":"InputEventKey"}]}
action_move_right={"deadzone":0.5,"events":[{"device":-1,"keycode":68,"physical_keycode":68,"unicode":0,"pressed":false,"type":"InputEventKey"}]}
action_jump={"deadzone":0.5,"events":[{"device":-1,"keycode":32,"physical_keycode":32,"unicode":32,"pressed":false,"type":"InputEventKey"}]}

action_toggle_mouse={"deadzone":0.5,"events":[{"device":-1,"keycode":81,"physical_keycode":81,"unicode":81,"pressed":false,"type":"InputEventKey"}]}

[rendering]

environment/default_environment="res://default_env.tres"
